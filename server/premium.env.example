# Salin ke /etc/beatplay-premium.env di VPS (chmod 600, JANGAN commit).
# Dipakai oleh beatplay-premium.service.
ADMIN_TOKEN=ganti-dengan-token-kuat
PUBLIC_BASE=https://premium.adminbeat.my.id

# ---- Kode verifikasi email (SMTP) ----
# Isi agar /api/auth/register benar-benar mengirim kode 6 digit ke email pendaftar.
# Selama belum diisi, server mengembalikan dev_code dan aplikasi menampilkan
# "Mode uji (SMTP belum aktif)".
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@adminbeat.my.id
SMTP_PASSWORD=ISI_PASSWORD_SMTP
SMTP_FROM=BeatPlay <no-reply@adminbeat.my.id>
# true = STARTTLS (port 587/25). Untuk port 465 (SMTPS) set SMTP_USE_TLS=false dan SMTP_USE_SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Aktifkan setelah kredensial + callback BuatQris siap. Rahasia jangan commit/kirim chat.
# PAYMENT_PROVIDER=buatqris
# BUATQRIS_MODE=sandbox
# BUATQRIS_ACCOUNT_ID=
# BUATQRIS_SECRET_TOKEN=
# BUATQRIS_SIGNING_SECRET=
# BUATQRIS_QRIS_METHOD=qris_two
# BUATQRIS_FEE_BY=user
# BUATQRIS_EXPIRY_MINUTES=15